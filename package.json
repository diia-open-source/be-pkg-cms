{
    "name": "@diia-inhouse/cms",
    "version": "3.3.24",
    "type": "module",
    "description": "Cms utils",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "repository": "https://github.com/diia-open-source/be-pkg-cms",
    "author": "Diia",
    "license": "SEE LICENSE IN LICENSE.md",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist"
    ],
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "prebuild": "rimraf dist",
        "build": "tsdown",
        "semantic-release": "semantic-release",
        "lint": "oxlint && oxfmt --check .",
        "lint-fix": "oxlint --fix && oxfmt .",
        "lint:lockfile": "lockfile-lint --path package-lock.json --allowed-hosts registry.npmjs.org --validate-https",
        "prepare": "npm run build",
        "find-circulars": "madge --circular --extensions ts ./",
        "test": "vitest run",
        "test:watch": "vitest watch"
    },
    "dependencies": {
        "qs": "6.15.2"
    },
    "peerDependencies": {
        "@diia-inhouse/errors": ">=2.0.0",
        "@diia-inhouse/http": ">=5.0.0",
        "@diia-inhouse/types": ">=13.0.0"
    },
    "devDependencies": {
        "@commitlint/cli": "20.4.2",
        "@diia-inhouse/configs": "7.0.1",
        "@diia-inhouse/diia-logger": "4.3.17",
        "@diia-inhouse/errors": "2.1.14",
        "@diia-inhouse/http": "5.1.16",
        "@diia-inhouse/oxc-config": "1.11.0",
        "@diia-inhouse/test": "8.2.10",
        "@diia-inhouse/types": "13.2.4",
        "@types/node": "25.6.2",
        "@types/qs": "6.15.1",
        "@vitest/coverage-v8": "4.1.5",
        "@vitest/ui": "4.1.5",
        "lockfile-lint": "5.0.0",
        "madge": "8.0.0",
        "n": "10.2.0",
        "oxfmt": "0.48.0",
        "oxlint": "1.63.0",
        "oxlint-tsgolint": "0.22.1",
        "rimraf": "6.1.3",
        "semantic-release": "25.0.3",
        "tsdown": "0.22.0",
        "vite-tsconfig-paths": "6.1.1",
        "vitest": "4.1.5",
        "vitest-mock-extended": "4.0.0"
    },
    "release": {
        "extends": "@diia-inhouse/configs/dist/semantic-release/package",
        "branches": [
            "main"
        ]
    },
    "commitlint": {
        "extends": "@diia-inhouse/configs/dist/commitlint"
    },
    "madge": {
        "tsConfig": "./tsconfig.json"
    }
}
